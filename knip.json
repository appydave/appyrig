{
  "$schema": "./node_modules/knip/schema.json",
  "includeEntryExports": true,
  "ignoreIssues": {
    "scripts/oxlint-gate.d.mts": ["exports", "types"],
    "playwright.config.ts": ["exports"],
    "e2e/support/global-teardown.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "bin/appyrig.mjs!",
        "scripts/*.{ts,mjs}",
        "scripts/provenance/main.ts",
        "scripts/vitest/build-shared.mjs",
        "lint/**/*.{js,mjs}",
        "e2e/**/*.spec.ts",
        "e2e/support/global-teardown.ts",
        "test/root/**/*.test.ts",
        "playwright.config.ts"
      ],
      "project": ["bin/**", "scripts/**", "lint/**", "e2e/**", "test/**", "*.{js,ts,mjs}!"],
      "ignore": ["test/fixtures/**", "test/root/fixtures/**"],
      "playwright": false,
      "ignoreBinaries": ["tsx", "vitest"]
    },
    "client": {
      "entry": ["src/main.tsx!"],
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/**/*.test.{ts,tsx}!",
        "!src/**/test/**!",
        "!src/**/*test-kit*!"
      ],
      "ignoreDependencies": ["tailwindcss"],
      "ignoreIssues": {
        "src/app/devProxy.ts": ["files"]
      }
    },
    "server": {
      "entry": ["src/index.ts!", "scripts/*.mjs"],
      "project": [
        "src/**/*.ts!",
        "scripts/**",
        "!src/**/*.test.{ts,tsx}!",
        "!src/**/test/**!",
        "!src/**/*test-kit*!"
      ],
      "ignore": ["src/core/vendor/**"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "collector": {
      "entry": ["src/main.ts!", "src/index.ts!", "scripts/*.{ts,mjs}"],
      "project": [
        "src/**/*.ts!",
        "scripts/**",
        "!src/**/*.test.{ts,tsx}!",
        "!src/**/test/**!",
        "!src/**/*test-kit*!"
      ],
      "ignoreBinaries": ["plutil"],
      "ignoreIssues": {
        "src/snapshotCases.ts": ["files"],
        "src/adapters/fixtureSources.ts": ["files"]
      }
    },
    "shared": {
      "entry": ["src/index.ts!"],
      "project": [
        "src/**/*.ts!",
        "!src/**/*.test.{ts,tsx}!",
        "!src/**/test/**!",
        "!src/**/*test-kit*!"
      ]
    }
  }
}
