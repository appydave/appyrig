{
  "name": "@appydave/appyrig",
  "version": "0.1.0",
  "private": true,
  "description": "Live view of agent teams across machines",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "collector"
  ],
  "scripts": {
    "dev": "npm run build -w shared && concurrently --kill-others -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && NODE_ENV=production npm run build -w client && npm run build -w collector",
    "test": "npm run test -w server -w client -w collector && npm run test:root",
    "test:coverage": "npm run test:coverage -w server -w client",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "oxlint": "node scripts/oxlint-gate.mjs",
    "oxlint:baseline": "node scripts/oxlint-gate.mjs --update",
    "stylelint": "stylelint \"client/src/**/*.css\"",
    "stylelint:baseline": "stylelint \"client/src/**/*.css\" --suppress",
    "stylelint:ratchet": "npm run stylelint && npm run stylelint:baseline && git diff --exit-code -- stylelint-suppressions.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w shared -w server -w client -w collector && tsc -p tsconfig.e2e.json",
    "clean": "rm -rf node_modules shared/dist server/dist client/dist",
    "prepare": "husky",
    "customize": "tsx scripts/customize.ts",
    "test:contract": "npm run test:contract -w collector",
    "api:check": "tsx scripts/gen-api.ts --check",
    "test:trust": "node scripts/test-trust.mjs",
    "arch:check": "depcruise shared/src server/src server/scripts client/src collector/src --config .dependency-cruiser.cjs && node scripts/arch-strings.mjs",
    "fake-collector": "node server/scripts/fake-collector.mjs",
    "api:gen": "tsx scripts/gen-api.ts",
    "snapshots:update": "tsx scripts/update-snapshots.ts",
    "test:root": "vitest run --config test/root/vitest.config.ts",
    "atlas:sync": "node scripts/sync-atlas.mjs",
    "rig-commands:sync": "node scripts/sync-rig-commands.mjs",
    "provenance": "tsx scripts/provenance/main.ts"
  },
  "devDependencies": {
    "@appydave/appystack-config": "^1.0.3",
    "@clack/prompts": "^1.7.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "concurrently": "^10.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxlint": "1.66.0",
    "oxlint-plugin-anti-slop": "github:sirknigget/anti-slop#cc0382b565489d0c55a9b071784e73f00e6acb0c",
    "prettier": "^3.9.5",
    "stylelint": "17.16.0",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md}": "prettier --write",
    "*.{ts,tsx,js}": "eslint --fix --prune-suppressions"
  },
  "author": "David Cruwys",
  "license": "MIT",
  "bin": {
    "appyrig": "bin/appyrig.mjs"
  }
}
