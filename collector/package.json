{
  "name": "@appydave/collector",
  "version": "0.1.0",
  "private": true,
  "description": "AppyRig collector: reads one machine (OpenRig daemon on localhost, tmux, the terminal viewer) and pushes snapshots to the hub",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run src/adapters/contract.test.ts"
  },
  "dependencies": {
    "@appydave/shared": "*",
    "socket.io-client": "^4.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "vitest": "^4.1.10",
    "socket.io": "^4.8.1",
    "tsc-alias": "^1.9.0"
  }
}
